{
  "manifest_version": 3,
  "name": "Bright Horizons Picture Scraper",
  "version": "1.0.0",
  "description": "Captures and downloads snapshot images from the Bright Horizons parent portal.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://mbdgw.brighthorizons.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
